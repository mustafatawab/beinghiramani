# Studio concierge (Google Gemini)
# Create a key at https://aistudio.google.com/apikey — the free tier covers a
# normal storefront's traffic. Keep this server-side only; never prefix it with
# NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3-flash. Use a Flash-Lite model if you need a
# higher requests-per-minute allowance on the free tier.
GEMINI_MODEL=gemini-3-flash
